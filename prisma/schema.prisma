// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma" // opcional, você pode omitir para gerar em node_modules
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReceivedCheckStatus {
  RECEIVED    
  FINALIZED   
  CANCELLED
}

enum CheckUsageType {
  DEPOSIT    
  PAYABLE    
}

enum FinancialFlowType {
  IN
  OUT
}

enum FinancialStatus {
  OPEN
  PAID        
  CANCELLED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum UserRole {
  ADMIN
  USER
}

enum AccountType {
  BANK
  CASHBOOK
}

enum EmployeePositionEnum {
  TAX_DEPARTMENT_MANAGER
  PERSONNEL_DEPARTMENT_MANAGER
  MOTORBOY
  TAX_ASSISTANT_N5
  PERSONNEL_DEPARTMENT_ASSISTANT
  TAX_ASSISTANT_N3
  TAX_ASSISTANT_N1
  OFFICE_ASSISTANT
  CLEANING_ASSISTANT
  ADMINISTRATIVE_ASSISTANT
  TAX_ASSISTANT_N6
  TAX_ASSISTANT_N4
  TAX_ASSISTANT_N2
}

model User {
  id        String @id @default(uuid())

  login     String @unique
  password  String 

  name      String
  lastName  String

  role      UserRole @default(USER)

  status    UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Employee {
  id                 String    @id @default(uuid())
  name               String
  document           String 
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime? @updatedAt
  dateOfBirth        DateTime?

  employeePositionId String
  employeePosition   EmployeePosition @relation(fields: [employeePositionId], references: [id])

  advances           EmployeeAdvance[]

  @@map("employees")
}

model EmployeePosition {
  id          String @id @default(uuid())
  position    EmployeePositionEnum

  employee    Employee[]
}

model EmployeeAdvance {
  id         String   @id @default(uuid())
  amount     Decimal  @db.Decimal(15,2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  reasonId String
  reason   AdvanceReason @relation(fields: [reasonId], references: [id])

  @@map("employee_advances")
}

model AdvanceReason {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  advances  EmployeeAdvance[]

  @@map("advance_reasons")
}

model Customer {
  id                 String @id @default(uuid())
  name               String
  code               String
  numberId           Int @unique
  isActive  Boolean   @default(true)

  receivedChecks     ReceivedCheck[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("customers")
} 

model Bank {
  id                 String @id @default(uuid())
  name               String
  agencies           String[]

  receivedChecks     ReceivedCheck[]
  account            Account[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banks")
}

model Account {
  id                 String   @id @default(uuid())
  balance            Decimal  @db.Decimal(15,2)
  accountNumber      String?
  accountType        AccountType @default(BANK)

  bankId             String?
  bank               Bank? @relation(fields: [bankId], references: [id])

  bankStatement      BankStatement[]
  cashBook           CashBook[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model BankStatement {
  id                   String @id @default(uuid())
  value                Float
  title                String
  description          String

  filePath             String?
  accountId            String
  account              Account @relation(fields: [accountId], references: [id])  

  financialCategoryId  String
  financialCategory    FinancialCategory @relation(fields: [financialCategoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CashBook {
  id                   String @id @default(uuid())
  value                Float
  title                String
  description          String

  filePath             String?

  accountId            String
  account              Account @relation(fields: [accountId], references: [id])  

  financialCategoryId  String
  financialCategory    FinancialCategory @relation(fields: [financialCategoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReceivedCheck {
  id            String @id @default(uuid())
  checkNumber   Int
  amount        Float
  agency        String
  goodForAt     DateTime?
  notes         String?
  paidAt        DateTime?
  status        ReceivedCheckStatus @default(RECEIVED)

  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])

  bankId        String
  bank          Bank @relation(fields: [bankId], references: [id])

  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@map("received_checks")
}

model FinancialCategory {
  id                String            @id @default(uuid())
  name              String
  financialFlowType FinancialFlowType
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  payment           Payment[]
  cashBook          CashBook[]
  bankStatement     BankStatement[]
  recurringPayment  RecurringPayment[]

  @@map("financial_categories")
}


model Payment {
  id                  String    @id @default(uuid())
  name                String
  amount              Decimal   @db.Decimal(12, 2)
  dueDate             DateTime
  paidAt              DateTime?

  recurringPaymentId  String?
  recurringPayment    RecurringPayment? @relation(fields: [recurringPaymentId], references: [id], onDelete: SetNull)

  financialCategoryId String
  financialCategory   FinancialCategory @relation(fields: [financialCategoryId], references: [id])

  referenceMonth      DateTime? @db.Date

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([recurringPaymentId, referenceMonth])
  @@map("payments")
}

model RecurringPayment {
  id                  String   @id @default(uuid())
  name                String
  dueDay              Int
  isMonthly           Boolean  @default(false)
  isFixedAmount       Boolean  @default(false)
  fixedAmount         Decimal? @db.Decimal(12, 2)

  financialCategoryId String
  financialCategory   FinancialCategory @relation(fields: [financialCategoryId], references: [id])

  payments            Payment[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("recurring-payment")
}

model SystemConfig {
  id            String   @id @default(uuid())
  enabled       Boolean  @default(true)
  intervalHours Int?     
  runAtHour     Int?     
  lastBackupAt  DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("system_configs")
}