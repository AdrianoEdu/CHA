// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma" // opcional, você pode omitir para gerar em node_modules
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReceivedCheckStatus {
  RECEIVED    
  FINALIZED   
  CANCELLED
}

enum CheckUsageType {
  DEPOSIT    
  PAYABLE    
}

enum FinancialFlowType {
  IN
  OUT
}

enum FinancialStatus {
  OPEN
  PAID        
  CANCELLED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum UserRole {
  ADMIN
  USER
}

enum AccountType {
  BANK
  CASHBOOK
}

model User {
  id        String @id @default(uuid())

  login     String @unique
  password  String 

  name      String
  lastName  String

  role      UserRole @default(USER)

  status    UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Employee {
  id          String    @id @default(uuid())
  name        String
  document    String 
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  dateOfBirth DateTime
  
  advances  EmployeeAdvance[]

  @@map("employees")
}

model EmployeeAdvance {
  id         String   @id @default(uuid())
  amount     Decimal  @db.Decimal(15,2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  reasonId String
  reason   AdvanceReason @relation(fields: [reasonId], references: [id])

  @@map("employee_advances")
}

model AdvanceReason {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  advances  EmployeeAdvance[]

  @@map("advance_reasons")
}

model Customer {
  id                 String @id @default(uuid())
  name               String
  code               String
  numberId           Int @unique
  isActive  Boolean   @default(true)

  receivedChecks     ReceivedCheck[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("customers")
} 

model Bank {
  id                 String @id @default(uuid())
  name               String
  agencies           String[]

  receivedChecks     ReceivedCheck[]
  account            Account[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banks")
}

model Account {
  id                 String   @id @default(uuid())
  balance            Decimal  @db.Decimal(15,2)
  accountNumber      String?
  accountType        AccountType @default(BANK)

  bankId             String?
  bank               Bank? @relation(fields: [bankId], references: [id])

  bankStatement      BankStatement[]
  cashBook           CashBook[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model BankStatement {
  id                   String @id @default(uuid())
  value                Float
  title                String
  description          String

  filePath             String?
  accountId            String
  account              Account @relation(fields: [accountId], references: [id])  

  financialCategoryId  String
  financialCategory    FinancialCategory @relation(fields: [financialCategoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CashBook {
  id                   String @id @default(uuid())
  value                Float
  title                String
  description          String

  filePath             String?

  accountId            String
  account              Account @relation(fields: [accountId], references: [id])  

  financialCategoryId  String
  financialCategory    FinancialCategory @relation(fields: [financialCategoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReceivedCheck {
  id            String @id @default(uuid())
  checkNumber   Int
  amount        Float
  agency        String
  goodForAt     DateTime?
  notes         String?
  paidAt        DateTime?
  status        ReceivedCheckStatus @default(RECEIVED)

  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])

  bankId        String
  bank          Bank @relation(fields: [bankId], references: [id])

  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@map("received_checks")
}

model FinancialCategory {
  id                String @id @default(uuid())
  name              String
  financialFlowType FinancialFlowType
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  bankStatement     BankStatement[]
  cashBook          CashBook[]
  @@map("financial_categories")
}

model RecurringPayment {
  id             String    @id @default(uuid())
  name           String
  dueDay         Int
  isMonthly      Boolean   @default(false)
  isFixedAmount  Boolean   @default(false)
  fixedAmount    Decimal?  @db.Decimal(12, 2)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  payments       Payment[]

  @@map("recurring-payment")
}

model Payment {
  id                 String    @id @default(uuid())
  name               String
  amount             Decimal   @db.Decimal(12, 2)
  dueDate            DateTime
  paidAt             DateTime?

  recurringPaymentId String?
  recurringPayment   RecurringPayment? @relation(fields: [recurringPaymentId], references: [id], onDelete: SetNull)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("payments")
}

model SystemConfig {
  id            String   @id @default(uuid())
  enabled       Boolean  @default(true)
  intervalHours Int?     
  runAtHour     Int?     
  lastBackupAt  DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("system_configs")
}